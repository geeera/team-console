// The public `hooks` Worker: GitHub webhooks (#12) outside Cloudflare Access (ADR 0001, decision 4).
// It shares the api Worker's D1 database per environment; migrations live only in apps/api.
// Secrets (declared in src/env.ts) come from `wrangler secret put`; this Worker never gets the GitHub
// token (threat model on #12). VAPID_PUBLIC_KEY stays empty here and comes from deploy.yml's `--var`, like the api Worker's;
// VAPID_SUBJECT is the repository URL, never an e-mail (#11 threat model, row 4).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "team-console-hooks",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-15",
  "env": {
    "dev": {
      "name": "team-console-hooks-dev",
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-dev",
          "database_id": "c2aa81dc-a67a-4efb-8eb2-95d02d21aa87",
        },
      ],
    },
    "stage": {
      "name": "team-console-hooks-stage",
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-stage",
          "database_id": "57d7e07f-ef4d-49d5-9d30-b4192c0af039",
        },
      ],
    },
    "production": {
      "name": "team-console-hooks-production",
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-production",
          "database_id": "8ad685cb-f2eb-49dd-a4d2-46e40b8670f0",
        },
      ],
    },
  },
}
