// The `api` Worker: serves the SPA from static assets and owns /api/* (ADR 0001, decisions 4, 14, 19).
// Non-secret configuration only. Secrets (declared in src/env.ts) are set once by the owner with
// `wrangler secret put`; ACCESS_TEAM_DOMAIN, ACCESS_AUD and ACCESS_SERVICE_TOKEN_ID stay empty here (this repository is public) and are
// filled per environment in #21/#25; the GitHub App vars (GITHUB_APP_ID, GITHUB_APP_CLIENT_ID, OWNER_GITHUB_LOGIN) stay empty
// too and come from deploy.yml's `--var` (ADR 0003 decision 7), and so does VAPID_PUBLIC_KEY (#11, the environment's
// `vars.VAPID_PUBLIC_KEY`); VAPID_SUBJECT is the repository URL, not an e-mail (#11 threat model, row 4); OWNER_EMAIL is a secret, never a var. workers_dev stays on: Access sits in
// front of team-console-<env>.<account>.workers.dev (ADR 0001, decisions 7 and 14); preview_urls are off so no
// unprotected version URL exists. AUTH_MODE and ENVIRONMENT=local exist only as `--var` flags of `nx serve api`
// and the Dockerfile — never in an `env.*` block (tools/workspace-checks enforces it).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "team-console",
  "main": "src/main.ts",
  // Bound by workerd 1.20260815 that wrangler 4.124 / vitest-pool-workers 0.22 ship; bump together with them.
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "../../dist/apps/console/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/api/*" alone leaves "/api" and "/api/" to the SPA fallback, outside the auth check (#51). The manifest and
    // the /brand icons are answered per ENVIRONMENT by the Worker (#237, routes/app-identity.ts).
    "run_worker_first": ["/api", "/api/*", "/manifest.webmanifest", "/favicon.ico", "/brand/*"],
  },
  // The queue's sweep (#670, src/actions/sweep.ts): lapsed leases and Actions no-shows. One of the five free Cron
  // Triggers (ADR 0006 budgets one every 5 minutes); inherited by every env below.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Workers Logs (#843): stored for every env below, which inherit it (`observability` is an inheritable key). The api
  // Worker's alert on `actions setup write volume` and Workers Issues read from it. Free plan: 200k events a day, 3 days.
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "team-console-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOW_SERVICE_TOKEN": "true",
        "ACCESS_SERVICE_TOKEN_ID": "",
        "GITHUB_APP_ID": "",
        "GITHUB_APP_CLIENT_ID": "",
        "OWNER_GITHUB_LOGIN": "",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
        "RUNNER_RELEASE_VERSION": "",
        "RUNNER_MINIMUM_VERSION": "",
        // #634 PR 5 (S1): the release's SHA256SUMS text, set with RUNNER_RELEASE_VERSION; deploy.yml checks it against
        // the attested file before deploying. Empty with an empty version: no install one-liner is offered.
        "RUNNER_RELEASE_SHA256SUMS": "",
        // #759 kill switch of the Actions setup's write path: on for dev (owner decision 1 on #759), off on stage and
        // production until the write route passes its security review.
        "ALLOW_ACTIONS_SETUP_WRITE": "true",
        // #759: the origin baked into the rendered runner workflow; must equal the origin requests arrive on.
        "CONSOLE_PUBLIC_ORIGIN": "https://team-console-dev.geeera.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-dev",
          // Real D1 database id (#25; not a secret) — must match apps/hooks/wrangler.jsonc's `dev` id
          // (tools/workspace-checks asserts this). deploy.yml's guard fails the deploy if this ever regresses
          // to the dev scaffold placeholder id it shipped with before #25 (see tools/deploy-guard).
          "database_id": "c2aa81dc-a67a-4efb-8eb2-95d02d21aa87",
          "migrations_dir": "migrations",
        },
      ],
    },
    "stage": {
      "name": "team-console-stage",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOW_SERVICE_TOKEN": "true",
        "ACCESS_SERVICE_TOKEN_ID": "",
        "GITHUB_APP_ID": "",
        "GITHUB_APP_CLIENT_ID": "",
        "OWNER_GITHUB_LOGIN": "",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
        "RUNNER_RELEASE_VERSION": "",
        "RUNNER_MINIMUM_VERSION": "",
        "RUNNER_RELEASE_SHA256SUMS": "",
        // #759 kill switch: stays "false" until the write route (PR 4 of #759) passes its security review.
        "ALLOW_ACTIONS_SETUP_WRITE": "false",
        // #759: the origin baked into the rendered runner workflow; must equal the origin requests arrive on.
        "CONSOLE_PUBLIC_ORIGIN": "https://team-console-stage.geeera.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-stage",
          "database_id": "57d7e07f-ef4d-49d5-9d30-b4192c0af039",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "team-console-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOW_SERVICE_TOKEN": "false",
        "ACCESS_SERVICE_TOKEN_ID": "",
        "GITHUB_APP_ID": "",
        "GITHUB_APP_CLIENT_ID": "",
        "OWNER_GITHUB_LOGIN": "",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "https://github.com/geeera/team-console",
        "RUNNER_RELEASE_VERSION": "",
        "RUNNER_MINIMUM_VERSION": "",
        "RUNNER_RELEASE_SHA256SUMS": "",
        // #759 kill switch: stays "false" until the write route (PR 4 of #759) passes its security review.
        "ALLOW_ACTIONS_SETUP_WRITE": "false",
        // #759: the workers.dev origin, deterministic from the name above; a custom domain changes it here.
        "CONSOLE_PUBLIC_ORIGIN": "https://team-console-production.geeera.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "team-console-production",
          "database_id": "8ad685cb-f2eb-49dd-a4d2-46e40b8670f0",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
