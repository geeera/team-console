{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "scope:worker"],
  "implicitDependencies": ["console"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/dist/apps/console/browser/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "dependsOn": [
        {
          "projects": ["console"],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "tsc -p apps/api/tsconfig.app.json --noEmit",
          "wrangler deploy --dry-run --outdir ../../dist/apps/api --config apps/api/wrangler.jsonc --env dev"
        ],
        "parallel": false
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler d1 migrations apply team-console-dev --local --config apps/api/wrangler.jsonc --env dev"
      }
    },
    "fake-github": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "wrangler dev --config apps/api/fake-github/wrangler.jsonc --ip 127.0.0.1 --port 9999 --inspector-port 9339 --var FAKE_GITHUB_CLIENT_ID:Iv23liLOCALFAKE --var FAKE_GITHUB_CLIENT_SECRET:local-fake-secret"
      }
    },
    "fake-routines": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "wrangler dev --config apps/api/fake-routines/wrangler.jsonc --ip 127.0.0.1 --port 9998 --inspector-port 9338"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["console"],
          "target": "build"
        },
        "migrate"
      ],
      "options": {
        "command": "wrangler dev --config apps/api/wrangler.jsonc --env dev --port 8787 --var ENVIRONMENT:local --var AUTH_MODE:local --var GITHUB_MOCK:true --var OWNER_GITHUB_LOGIN:geeera"
      }
    }
  }
}
