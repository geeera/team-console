{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "scope:worker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/dist/apps/console/browser/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "dependsOn": [{ "projects": ["console"], "target": "build" }],
      "options": {
        "commands": [
          "tsc -p apps/api/tsconfig.app.json --noEmit",
          "wrangler deploy --dry-run --outdir ../../dist/apps/api --config apps/api/wrangler.jsonc --env dev"
        ],
        "parallel": false
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler d1 migrations apply team-console-dev --local --config apps/api/wrangler.jsonc --env dev"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [{ "projects": ["console"], "target": "build" }, "migrate"],
      "options": {
        "command": "wrangler dev --config apps/api/wrangler.jsonc --env dev --port 8787 --var ENVIRONMENT:local --var AUTH_MODE:local --var GITHUB_MOCK:true"
      }
    }
  }
}
